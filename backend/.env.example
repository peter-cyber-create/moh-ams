NODE_ENV=development
HOST=0.0.0.0
PORT=3020
DATABASE_URL="postgresql://ims:ims_secret@localhost:5435/ams_db"
FINANCE_DATABASE_URL="postgresql://ims:ims_secret@localhost:5435/ims_db"
FINANCE_API_URL="http://localhost:3000"
JWT_SECRET="same-as-finance-jwt-secret"
# Production: comma-separated browser origins. Include GitHub Pages when the UI is hosted there.
CORS_ORIGINS="http://localhost:3010,http://127.0.0.1:3010"
UPLOAD_DIR="uploads"
# Optional directory of the built frontend. When set, AMS serves the UI on the same origin.
WEB_DIST=""
